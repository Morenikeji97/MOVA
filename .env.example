NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seller identity verification (Stripe Identity) — Phase 2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Base URL used to build Stripe's return_url / Checkout success_url. Optional
# locally (falls back to the request host); set it in deployed environments.
NEXT_PUBLIC_APP_URL=

# Buyer service-fee payments (Stripe Checkout) — Phase 2. Its own webhook
# endpoint (/api/stripe/payments/webhook), so Stripe issues a signing secret
# separate from STRIPE_WEBHOOK_SECRET above.
STRIPE_PAYMENTS_WEBHOOK_SECRET=

# Added in later phases:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
