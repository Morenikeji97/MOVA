NEXT_PUBLIC_SUPABASE_URL=
# New-format Supabase publishable key (sb_publishable_…), from the dashboard:
# Settings → API Keys → "Publishable and secret API keys". Drop-in for the old
# `anon` key; the env var name is kept for compatibility.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seller identity verification (Stripe Identity) — Phase 2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# New-format Supabase secret key (sb_secret_…) — same dashboard tab as above.
# Server-only, bypasses RLS. Drop-in for the old `service_role` key.
SUPABASE_SERVICE_ROLE_KEY=
# Base URL used to build Stripe's return_url / Checkout success_url. Optional
# locally (falls back to the request host); set it in deployed environments.
NEXT_PUBLIC_APP_URL=

# Buyer service-fee payments (Stripe Checkout) — Phase 2. Its own webhook
# endpoint (/api/stripe/payments/webhook), so Stripe issues a signing secret
# separate from STRIPE_WEBHOOK_SECRET above.
STRIPE_PAYMENTS_WEBHOOK_SECRET=

# Shipper commission — Phase 3. Off-session card charges to shippers plus their
# signup card setup (Stripe Checkout in `setup` mode). Its OWN webhook endpoint
# (/api/stripe/shipper-commission/webhook), entirely separate from the buyer
# payments webhook above, so Stripe issues a distinct signing secret.
STRIPE_SHIPPER_COMMISSION_WEBHOOK_SECRET=

# Bank-transfer fallback for the buyer's MOVA service fee (alongside Stripe
# Checkout) — Phase 2. Server-only; never NEXT_PUBLIC. All five must be set
# for the "Pay by bank transfer" option to appear — the UI hides it
# otherwise rather than rendering incomplete details. These change once the
# LLC / business bank account exists, hence env vars rather than hardcoding.
BANK_TRANSFER_NAME=
BANK_TRANSFER_ADDRESS=
BANK_TRANSFER_SWIFT=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ROUTING_NUMBER=

# Abandoned-reservation auto-release (app/api/cron/release-reservations).
# Server-only. Authenticates the Supabase pg_cron job that hits this route
# every 15 minutes (0021_release_reservations_cron.sql) — must match the
# 'cron_secret' stored in Supabase Vault on the project.
CRON_SECRET=

# Floating WhatsApp contact button. NUMBER is E.164 digits only (no "+",
# spaces or dashes), e.g. 2348012345678. Both are optional — lib/whatsapp.ts
# has fallbacks; set NUMBER to an empty string to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# Added in later phases:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
